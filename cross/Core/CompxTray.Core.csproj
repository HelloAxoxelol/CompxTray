<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CompxTray.Core</AssemblyName>
    <RootNamespace>CompxTray</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- The protocol and settings logic are shared with the Windows build, which compiles them with csc.exe (C# 5). -->
  <ItemGroup>
    <Compile Include="..\..\src\Device\CompxDevice.cs" Link="Shared\CompxDevice.cs" />
    <Compile Include="..\..\src\Device\ConfigMap.cs" Link="Shared\ConfigMap.cs" />
    <Compile Include="..\..\src\Device\MouseConfig.cs" Link="Shared\MouseConfig.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>

</Project>
