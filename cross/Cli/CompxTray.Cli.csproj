<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>compxtray-cli</AssemblyName>
    <RootNamespace>CompxTray.Cli</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- HidSharp is not trim-safe and picks its backend per OS at run time, so it is kept whole. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="HidSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\CompxTray.Core.csproj" />
  </ItemGroup>

</Project>
